# 构建产物（本机用 Tools/rune.ps1 生成；macOS 上用 swift build 生成）
.build/
*.lib
*.exe
*.o
*.swiftmodule
*.swiftdoc
*.swiftinterface
ModuleCache/

# 由 rune.ps1 生成的测试入口（每次构建重新生成）
TestRunner.swift

# ---------- iOS App（由 CI 上的 XcodeGen 生成，见 docs/16）----------
#
# ⚠️ `Rune.xcodeproj` 是**生成物**，不进仓库。
#    理由：project.pbxproj 是没法人工解冲突的格式；两个人各加一个文件，
#    合并时会变成一段谁也不敢改的乱码。真相源是 `Apps/Rune/project.yml`。
Apps/Rune/Rune.xcodeproj/
# ⚠️ 注释必须**独占一行**：gitignore 不支持行尾注释，写成
#    `Apps/Rune/Info.plist   # 由 project.yml 生成` 的话，整行（含 `#` 与后面的字）都是模式，
#    于是它**永远匹配不到任何文件** —— 生成物照旧会被 `git add .` 收进仓库，
#    而规则看上去"已经写了"。C39 实测 `git check-ignore` 才发现的。
Apps/Rune/Info.plist
Apps/Rune/build/
Apps/Rune/ipa/
Apps/Rune/*.ipa
Apps/Rune/TestResults.xcresult
*.xcuserdatad/
xcuserdata/
DerivedData/
*.xcresult

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.swp

# 临时日志
*.log

# 说明：research/ 是**故意提交**的（465 份事实取证件，见 research/README.md）。
# 它是设计文档里每条"已核实"结论的证据链，不是构建产物，请不要加进 .gitignore。
