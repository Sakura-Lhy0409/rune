{"abstract":[{"text":"A Boolean value that indicates whether the app may create writable and executable memory using the ","type":"text"},{"code":"MAP_JIT","type":"codeVoice"},{"text":" flag.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.bundleresources\/documentation\/BundleResources","doc:\/\/com.apple.bundleresources\/documentation\/BundleResources\/Entitlements"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.bundleresources\/documentation\/BundleResources\/Entitlements\/com.apple.security.cs.allow-jit"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"entitlements:Entitlements.com.apple.security.cs.allow-jit","modules":[{"name":"Bundle Resources"}],"navigatorTitle":[{"kind":"text","text":"Allow execution of JIT-compiled code entitlement"}],"platforms":[{"beta":false,"deprecated":false,"introducedAt":"10.7","name":"macOS","unavailable":false}],"role":"symbol","roleHeading":"Property List Key","symbolKind":"typealias","title":"Allow execution of JIT-compiled code entitlement"},"primaryContentSections":[{"details":{"ideTitle":"Allow Execution of JIT-compiled Code Entitlement","name":"com.apple.security.cs.allow-jit","platforms":[],"titleStyle":"title","value":[{"arrayMode":false,"baseType":"boolean"}]},"kind":"details","title":"Details"},{"content":[{"anchor":"Discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"You can create memory that’s both writable and executable by passing the ","type":"text"},{"code":"MAP_JIT","type":"codeVoice"},{"text":" flag to the ","type":"text"},{"code":"mmap()","type":"codeVoice"},{"te