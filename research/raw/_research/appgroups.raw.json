{"abstract":[{"text":"A list of identifiers specifying the groups your app belongs to.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.bundleresources\/documentation\/BundleResources","doc:\/\/com.apple.bundleresources\/documentation\/BundleResources\/Entitlements"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.bundleresources\/documentation\/BundleResources\/Entitlements\/com.apple.security.application-groups"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"entitlements:Entitlements.com.apple.security.application-groups","modules":[{"name":"Bundle Resources"}],"navigatorTitle":[{"kind":"text","text":"App Groups Entitlement"}],"platforms":[{"beta":false,"deprecated":false,"introducedAt":"3.0","name":"iOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"3.0","name":"iPadOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"10.7","name":"macOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"9.0","name":"tvOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"2.0","name":"watchOS","unavailable":false}],"role":"symbol","roleHeading":"Property List Key","symbolKind":"typealias","title":"App Groups Entitlement"},"primaryContentSections":[{"details":{"ideTitle":"App Groups Entitlement","name":"com.apple.security.application-groups","platforms":[],"titleStyle":"title","value":[{"arrayMode":true,"baseType":"string "}]},"kind":"details","title":"Details"},{"content":[{"anchor":"Discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"App groups allow multiple apps produced by a single development team to access shared containers and keychain access groups, and communicate using interprocess communication (IPC). Apps may belong to one or more app groups.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Format the identifier as follows:","type":"text"}],"type":"paragraph"},{"code":["group.<group name>"],"syntax":"console","type":"codeListing"},{"inlineContent":[{"text":"Apple ensures that the group name you choose is unique when you register the app group on the Apple Developer website. For more information, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/account\/manage-identifiers\/register-an-app-group","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In macOS, you can also create app groups or add apps to existing app groups using this identifier format:","type":"text"}],"type":"paragraph"},{"code":["<team identifier>.<group name>"],"syntax":"console","type":"codeListing"},{"inlineContent":[{"text":"You don’t need to register app groups that use this format on the Apple Developer website.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Apps within an app group share access to a group container. For more information about container creation, location, and deletion, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/FileManager\/containerURL(forSecurityApplicationGroupIdentifier:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Apps within a group can communicate with other members in the group using IPC mechanisms including Mach IPC, XPC, POSIX semaphores and shared memory, and UNIX domain sockets. In macOS, use app groups to enable IPC communication between two sandboxed apps, or between a sandboxed app and a nonsandboxed app. You use the app group identifier in the service identifier for your IPC mechanism, so keep these restrictions in mind when creating your app group identifier:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"IPC mechanism","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Requirements","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Mach IPC, XPC","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The service name has the format ","type":"text"},{"code":"<group identifier>.<unique name>","type":"codeVoice"},{"text":". The maximum length of the service name is ","type":"text"},{"code":"BOOTSTRAP_MAX_NAME_LEN","type":"codeVoice"},{"text":" characters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"POSIX semaphores","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The service identifer has the format ","type":"text"},{"code":"<group identifier>\/<unique name>","type":"codeVoice"},{"text":". The maximum length of the service identifier is ","type":"text"},{"code":"PSEMNAMLEN","type":"codeVoice"},{"text":" characters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"POSIX shared memory","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The service identifer has the format ","type":"text"},{"code":"<group identifier>\/<unique name>","type":"codeVoice"},{"text":". The maximum length of the service identifier is ","type":"text"},{"code":"PSHMNAMLEN","type":"codeVoice"},{"text":" characters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"UNIX domain sockets","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The path to the socket needs to be in your app group container, and the name of the socket is limited to ","type":"text"},{"code":"SOCK_MAXADDRLEN","type":"codeVoice"},{"text":" characters, which includes two bytes that are reserved for ","type":"text"},{"code":"sun_len","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sun_family","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"App groups that you register in your Apple Developer profile also act as keychain access groups. For more information about the relationship between app groups and keychain access groups, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Security\/sharing-access-to-keychain-items-among-a-collection-of-apps","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To add this entitlement to your app, enable the App Groups capability in Xcode, and add the groups your app belongs to.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Application-groups","generated":true,"identifiers":["doc:\/\/com.apple.bundleresources\/documentation\/BundleResources\/Entitlements\/keychain-access-groups"],"title":"Application groups"}],"variants":[{"paths":["\/documentation\/bundleresources\/entitlements\/com.apple.security.application-groups"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/bundleresources\/entitlements\/com.apple.security.application-groups"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.apple.bundleresources/documentation/BundleResources":{"abstract":[{"text":"Resources located in an app, framework, or plugin bundle.","type":"text"}],"identifier":"doc:\/\/com.apple.bundleresources\/documentation\/BundleResources","kind":"symbol","navigatorTitle":[{"kind":"text","text":"Bundle Resources"}],"role":"collection","title":"Bundle Resources","type":"topic","url":"\/documentation\/bundleresources"},"doc://com.apple.bundleresources/documentation/BundleResources/Entitlements":{"abstract":[{"text":"Key-value pairs that grant an executable permission to use a service or technology.","type":"text"}],"identifier":"doc:\/\/com.apple.bundl