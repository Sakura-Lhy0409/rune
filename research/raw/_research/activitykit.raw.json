{"abstract":[{"text":"Share live updates from your app as Live Activities on iPhone, iPad, Apple Watch, and the Mac.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.activitykit\/documentation\/ActivityKit"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"ActivityKit","images":[{"identifier":"ActivityKit-PageImage-card.png","type":"card"}],"modules":[{"name":"ActivityKit"}],"platforms":[{"beta":false,"introducedAt":"16.1","name":"iOS"},{"beta":false,"introducedAt":"16.1","name":"iPadOS"},{"beta":false,"introducedAt":"16.1","name":"Mac Catalyst"}],"role":"collection","roleHeading":"Framework","symbolKind":"module","title":"ActivityKit"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"With the ActivityKit framework, you can start a Live Activity to share live updates from your app. Live Activities offer a rich, interactive, and highly glanceable way for people to keep track of an event or activity over several hours, especially for apps that push the limit of notifications to provide updated information. For example, a sports app might start a Live Activity that makes live information available at a glance for the duration of a game.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A Live Activity appears in highly visible contexts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"On iPad and iPhone, it appears on the Lock Screen, in the Dynamic Island, and on the Home Screen.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On Apple Watch, it appears in the Smart Stack.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On Mac, it appears in the Menu bar.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In CarPlay, it appears on the Home Screen.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"In addition to viewing real-time information, people perform essential functionality without launching your app using buttons or toggles included in a Live Activity layout or tap the Live Activity to launch the app to a scene that matches the activity’s content.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"live-activity-dynamic-island","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"In your app, use ActivityKit to configure, start, update, and end the Live Activity, and create the user interface of your Live Activities with a widget extension, ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/WidgetKit","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI","isActive":true,"type":"reference"},{"text":". By using SwiftUI and WidgetKit, you can share code between widgets and Live Activities or develop them in tandem.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"However, Live Activities use a different mechanism to receive updates compared to widgets. Instead of using a timeline mechanism, Live Activities receive updated data from your app with ActivityKit and from your server with ActivityKit push notifications, and you can start Live Activities with ActivityKit push notifications.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"visionOS doesn’t support Live Activities. Requests to start a Live Activity from a compatible iPad or iPhone app fail.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/com.apple.documentation\/documentation\/WidgetKit\/Developing-a-WidgetKit-strategy","doc:\/\/com.apple.documentation\/documentation\/Updates\/ActivityKit"],"title":"Essentials"},{"anchor":"Starting-a-Live-Activity","identifiers":["doc:\/\/com.apple.activitykit\/documentation\/ActivityKit\/displaying-live-data-with-live-activities","doc:\/\/com.apple.activitykit\/documentation\/ActivityKit\/starting-and-updating-live-activities-with-activitykit-push-notifications","doc:\/\/com.apple.activitykit\/documentation\/ActivityKit\/Activity","doc:\/\/com.apple.documentation\/documentation\/WidgetKit\/emoji-rangers-supporting-live-activities-interactivity-and-animations","doc:\/\/com.apple.documentation\/documentation\/BundleResources\/Information-Property-List\/NSSupportsLiveActivities","doc:\/\/com.apple.documentation\/documentation\/BundleResources\/Information-Property-List\/NSSupportsLiveActivitiesFrequentUpdates"],"title":"Starting a Live Activity"},{"anchor":"User-interface","identifiers":["doc:\/\/com.apple.activitykit\/documentation\/ActivityKit\/creating-custom-views-for-live-activities","doc:\/\/com.apple.activitykit\/documentation\/ActivityKit\/adding-accessible-descriptions-to-widgets-and-live-activities","doc:\/\/com.apple.activitykit\/documentation\/ActivityKit\/launching-your-app-from-a-live-activity"],"title":"User interface"},{"anchor":"Widget-ecosystem","identifiers":["doc:\/\/com.apple.documentation\/documentation\/WidgetKit\/Creating-a-Widget-Extension","doc:\/\/com.apple.documentation\/documentation\/WidgetKit\/Animating-data-updates-in-widgets-and-live-activities","doc:\/\/com.apple.documentation\/documentation\/WidgetKit\/Creating-views-for-widgets-Live-Activities-and-watch-complications","doc:\/\/com.apple.documentation\/documentation\/WidgetKit\/Linking-to-specific-app-scenes-from-your-widget-or-Live-Activity","doc:\/\/com.apple.documentation\/documentation\/WidgetKit"],"title":"Widget ecosystem"}],"variants":[{"paths":["\/documentation\/activitykit"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"ActivityKit-PageImage-card.png":{"alt":"[A hero image of the ActivityKit framework.]","identifier":"ActivityKit-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.activitykit\/ActivityKit-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.activitykit\/ActivityKit-PageImage-card~dark@2x.png"}]},"Developing-a-WidgetKit-strategy-PageImage-card.png":{"alt":"A collection of widgets in different sizes.","identifier":"Developing-a-WidgetKit-strategy-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.WidgetKit\/Developing-a-WidgetKit-strategy-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.WidgetKit\/Developing-a-WidgetKit-strategy-PageImage-card~dark@2x.png"}]},"Emoji-Rangers-PageImage-card.png":{"alt":"An illustration that shows a screen shot of an Emoji Rangers Live Activity on Apple Watch, next to an illustration of a panda bear.","identifier":"Emoji-Rangers-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.WidgetKit\/Emoji-Rangers-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.WidgetKit\/Emoji-Rangers-PageImage-card~dark@2x.png"}]},"SwiftUI-PageImage-card.png":{"alt":"A stylized Swift logo using dashes on a white or blue background.","identifier":"SwiftUI-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card~dark@2x.png"}]},"doc://com.apple.activitykit/documentation/ActivityKit":{"abstract":[{"text