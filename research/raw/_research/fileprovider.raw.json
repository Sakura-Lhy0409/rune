{"abstract":[{"text":"An extension other apps use to access files and folders managed by your app and synced with a remote storage.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.fileprovider\/documentation\/FileProvider"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"FileProvider","modules":[{"name":"File Provider"}],"navigatorTitle":[{"kind":"text","text":"File Provider"}],"platforms":[{"beta":false,"introducedAt":"11.0","name":"iOS"},{"beta":false,"introducedAt":"11.0","name":"iPadOS"},{"beta":false,"introducedAt":"11.0","name":"Mac Catalyst"},{"beta":false,"introducedAt":"10.15","name":"macOS"},{"beta":false,"introducedAt":"1.0","name":"visionOS"}],"role":"collection","roleHeading":"Framework","symbolKind":"module","title":"File Provider"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"If your app focuses on providing and syncing user documents from remote storage, you can implement a File Provider extension to give users access to those documents when they’re using other apps. If you just need to share local documents, see ","type":"text"},{"identifier":"doc:\/\/com.apple.fileprovider\/documentation\/FileProvider#Share-files-locally","isActive":true,"type":"reference"},{"text":" below.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"media-4032695","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"The framework has two different starting points for building your File Provider extension.","type":"tex