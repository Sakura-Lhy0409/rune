{"abstract":[{"text":"A tool that a model can call to gather information at runtime or perform side effects.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Tool"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"s:16FoundationModels4ToolP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tool"}],"modules":[{"name":"Foundation Models"}],"navigatorTitle":[{"kind":"identifier","text":"Tool"}],"platforms":[{"beta":false,"deprecated":false,"introducedAt":"26.0","name":"iOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"26.0","name":"iPadOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"26.0","name":"Mac Catalyst","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"26.0","name":"macOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"26.0","name":"visionOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"27.0","name":"watchOS","unavailable":false}],"role":"symbol","roleHeading":"Protocol","symbolKind":"protocol","title":"Tool"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst","macOS","visionOS","watchOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tool"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Tool\/Arguments","kind":"typeIdentifier","preciseIdentifier":"s:16FoundationModels4ToolP9ArgumentsQa","text":"Arguments"},{"kind":"text","text":", "},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Tool\/Output","kind":"typeIdentifier","preciseIdentifier":"s:16FoundationModels4ToolP6OutputQa","text":"Output"},{"kind":"text","text":"> : "},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/composing-dynamic-sessions-with-instructions-and-profiles","doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/generating-content-and-performing-tasks-with-foundation-models","doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/categorizing-and-organizing-data-with-content-tags","doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/expanding-generation-with-tool-calling","doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/optimizing-key-value-caching-in-language-model-sessions","doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/running-a-core-ai-model-in-a-foundation-models-session"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Tool calling gives the model the ability to call your code to incorporate","type":"text"},{"text":" ","type":"text"},{"text":"up-to-date information like recent events and data from your app. A tool","type":"text"},{"text":" ","type":"text"},{"text":"includes a name and a description that the framework puts in the prompt to let","type":"text"},{"text":" ","type":"text"},{"text":"the model decide when and how often to call your tool.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Tool","type":"codeVoice"},{"text":" defines a ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Tool\/call(arguments:)","isActive":true,"type":"reference"},{"text":" method that takes arguments that conforms to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/ConvertibleFromGeneratedContent","isActive":true,"type":"reference"},{"text":", and returns an output of any type that conforms to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/PromptRepresentable","isActive":true,"type":"reference"},{"text":", allowing the model to understand and reason about in subsequent","type":"text"},{"text":" ","type":"text"},{"text":"interactions. Typically, ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Tool\/Output","isActive":true,"type":"reference"},{"text":" is a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" or any ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Generable","isActive":true,"type":"reference"},{"text":" types.","type":"text"}],"type":"paragraph"},{"code":["struct FindContacts: Tool {","    let name = \"findContacts\"","    let description = \"Finds a specific number of contacts\"","","    @Generable","    struct Arguments {","        @Guide(description: \"The number of contacts to get\", .range(1...10))","        let count: Int","    }","","    func call(arguments: Arguments) async throws -> [String] {","        var contacts: [CNContact] = []","        \/\/ Fetch a number of contacts using the arguments.","        let formattedContacts = contacts.map {","            \"\\($0.givenName) \\($0.familyName)\"","        }","        return formattedContacts","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Tools must conform to ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Sendable","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"so the framework can run them concurrently. If the model needs to pass the output","type":"text"},{"text":" ","type":"text"},{"text":"of one tool as the input to another, it executes back-to-back tool calls.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You control the life cycle of your tool, so you can track the state of it between","type":"text"},{"text":" ","type":"text"},{"text":"calls to the model. For example, you might store a list of database records that","type":"text"},{"text":" ","type":"text"},{"text":"you don’t want to reuse between tool calls.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Prompting the model with tools contributes to the available context window size.","type":"text"},{"text":" ","type":"text"},{"text":"When you provide a tool in your generation request, the framework puts the tool","type":"text"},{"text":" ","type":"text"},{"text":"definitions — name, description, parameter information — in the prompt so the","type":"text"},{"text":" ","type":"text"},{"text":"model can decide when and how often to call the tool. After calling your tool,","type":"text"},{"text":" ","type":"text"},{"text":"the framework returns the tool’s output back to the model for further processing.","type":"text"},{"text":" ","type":"text"},{"text":"For more information on managing the context window size, see ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/managing-the-context-window","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.documentation\/documentation\/Swift\/Sendable","doc:\/\/com.apple.documentation\/documentation\/Swift\/SendableMetatype"],"kind":"relationships"