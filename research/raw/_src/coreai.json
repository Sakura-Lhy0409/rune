{"abstract":[{"text":"Run AI models in your app on Apple silicon.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.coreai\/documentation\/CoreAI"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"CoreAI","modules":[{"name":"Core AI"}],"navigatorTitle":[{"kind":"text","text":"Core AI"}],"platforms":[{"beta":false,"introducedAt":"27.0","name":"iOS"},{"beta":false,"introducedAt":"27.0","name":"iPadOS"},{"beta":false,"introducedAt":"27.0","name":"Mac Catalyst"},{"beta":false,"introducedAt":"27.0","name":"macOS"},{"beta":false,"introducedAt":"27.0","name":"tvOS"},{"beta":false,"introducedAt":"27.0","name":"visionOS"},{"beta":false,"introducedAt":"27.0","name":"watchOS"}],"role":"collection","roleHeading":"Framework","symbolKind":"module","title":"Core AI"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Core AI helps you build, run, and deploy AI models in your app. Designed with Apple silicon in mind, Core AI allows your app to use the latest model architectures and inference techniques across the CPU, GPU, and Neural Engine. The Swift API makes common tasks simple, while giving you more control over model specialization, caching, and inference performance when needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"core-ai-framework-hero","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"Alongside the framework, Core AI includes additional tools for model preparation, integration, and debugging. Prepare your models for Apple silicon with ","type":"text"},{"identifier":"https:\/\/apple.github.io\/coreai-optimization","isActive":true,"type":"reference"},{"text":", then convert them into the ","type":"text"},{"code":".aimodel","type":"codeVoice"},{"text":" format with ","type":"text"},{"identifier":"https:\/\/apple.github.io\/coreai-torch","isActive":true,"type":"reference"},{"text":". The ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/core-ai-debugger\/","isActive":true,"type":"reference"},{"text":" app supports visualization and numeric debugging, letting you inspect model structure and trace tensor values directly back to your Python source code. For a catalog of ready-to-export models and a Swift package with helpers for common inference patterns, see ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/coreai-models","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Core AI also integrates with Xcode and the developer toolchain. The Core AI debug gauge and Core AI instrument help you monitor and profile inference performance in your app. You can also compile models ahead of time with the ","type":"text"},{"code":"coreai-build","type":"codeVoice"},{"text":" command-line tool.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If your app uses model types other than neural networks, such as decision trees or tabular feature engineering, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/CoreML","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/com.apple.coreai\/documentation\/CoreAI\/integrating-on-device-ai-models-in-your-app-with-core-ai","doc:\/\/com.apple.coreai\/documentation\/CoreAI\/AIModel","doc:\/\/com.apple.coreai\/documentation\/CoreAI\/AIModelAsset"],"titl